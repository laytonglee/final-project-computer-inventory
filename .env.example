# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/computer-inventory?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_very_long_random_secret_string_at_least_64_characters
JWT_EXPIRE=24h

# Session (for flash messages - use a long random string)
SESSION_SECRET=replace_this_with_another_long_random_secret_string

# Initial Admin (used by seed script)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123!
