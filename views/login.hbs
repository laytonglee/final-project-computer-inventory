<div class="auth-wrapper">

  <!-- Left: Branded Panel -->
  <div class="auth-panel">
    <div class="auth-panel-inner">
      <div class="auth-logo">
        <div class="auth-logo-icon">
          <i class="fas fa-server"></i>
        </div>
      </div>
      <h1 class="auth-panel-title">IT Inventory<br />System</h1>
      <p class="auth-panel-sub">Manage your IT assets with confidence. Track,
        monitor, and audit all equipment in one place.</p>
      <ul class="auth-features">
        <li><i class="fas fa-check-circle"></i> Real-time asset tracking</li>
        <li><i class="fas fa-check-circle"></i> Role-based access control</li>
        <li><i class="fas fa-check-circle"></i> Full transaction history</li>
        <li><i class="fas fa-check-circle"></i>
          Detailed reports & analytics</li>
      </ul>
    </div>
    <!-- Decorative blobs -->
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>
    <div class="auth-blob auth-blob-3"></div>
  </div>

  <!-- Right: Form Panel -->
  <div class="auth-form-panel">
    <div class="auth-form-inner">

      <div class="auth-form-header">
        <h2 class="auth-form-title">Welcome back</h2>
        <p class="auth-form-sub">Sign in to your account to continue</p>
      </div>

      {{#each errorMessages}}
        <div class="auth-alert auth-alert-danger">
          <i class="fas fa-exclamation-circle"></i>
          <span>{{this}}</span>
        </div>
      {{/each}}
      {{#each successMessages}}
        <div class="auth-alert auth-alert-success">
          <i class="fas fa-check-circle"></i>
          <span>{{this}}</span>
        </div>
      {{/each}}

      <form action="/login" method="POST" novalidate>

        <div class="auth-field">
          <label for="username" class="auth-label">Username</label>
          <div class="auth-input-wrap">
            <i class="fas fa-user auth-input-icon"></i>
            <input
              type="text"
              id="username"
              name="username"
              class="auth-input"
              placeholder="Enter your username"
              required
              autofocus
              autocomplete="username"
            />
          </div>
        </div>

        <div class="auth-field">
          <label for="password" class="auth-label">Password</label>
          <div class="auth-input-wrap">
            <i class="fas fa-lock auth-input-icon"></i>
            <input
              type="password"
              id="password"
              name="password"
              class="auth-input"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            />
            <button
              type="button"
              class="auth-toggle-pw"
              id="togglePassword"
              tabindex="-1"
              aria-label="Toggle password visibility"
            >
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="auth-submit">
          <i class="fas fa-arrow-right-to-bracket"></i>
          Sign In
        </button>

      </form>

      <p class="auth-footer-note">
        <i class="fas fa-shield-halved"></i>
        Secure, encrypted connection
      </p>

    </div>
  </div>

</div>

<script>
  document.getElementById('togglePassword').addEventListener('click', function
  () { const input = document.getElementById('password'); const icon =
  document.getElementById('eyeIcon'); if (input.type === 'password') {
  input.type = 'text'; icon.classList.replace('fa-eye', 'fa-eye-slash'); } else
  { input.type = 'password'; icon.classList.replace('fa-eye-slash', 'fa-eye'); }
  });
</script>