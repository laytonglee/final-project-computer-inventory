<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0"><i class="fas fa-desktop me-2 text-primary"></i>Inventory</h4>
  <a href="/items/new" class="btn btn-primary">
    <i class="fas fa-plus me-1"></i> Add Item
  </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-3">
    <form class="row g-2 align-items-end" method="GET" action="/items">
      <div class="col-md-4">
        <input type="text" name="search" value="{{filter.search}}" class="form-control"
               placeholder="Search by ID, model, brand, serial...">
      </div>
      <div class="col-md-2">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <option value="Available"   {{#if (eq filter.status "Available")}}selected{{/if}}>Available</option>
          <option value="In-Use"      {{#if (eq filter.status "In-Use")}}selected{{/if}}>In-Use</option>
          <option value="Maintenance" {{#if (eq filter.status "Maintenance")}}selected{{/if}}>Maintenance</option>
          <option value="Retired"     {{#if (eq filter.status "Retired")}}selected{{/if}}>Retired</option>
        </select>
      </div>
      <div class="col-md-2">
        <select name="category" class="form-select">
          <option value="">All Categories</option>
          <option value="Computer"   {{#if (eq filter.category "Computer")}}selected{{/if}}>Computer</option>
          <option value="Peripheral" {{#if (eq filter.category "Peripheral")}}selected{{/if}}>Peripheral</option>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">
          <i class="fas fa-search me-1"></i> Filter
        </button>
        <a href="/items" class="btn btn-outline-secondary ms-1">
          <i class="fas fa-times me-1"></i> Clear
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Items Table -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    {{#if items.length}}
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Item ID</th>
            <th>Brand / Model</th>
            <th>Category</th>
            <th>Serial #</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Acquired</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td><code class="fw-semibold">{{itemId}}</code></td>
            <td>
              <div class="fw-semibold">{{brand}}</div>
              <small class="text-muted">{{model}} · {{subtype}}</small>
            </td>
            <td><span class="badge bg-light text-dark border">{{category}}</span></td>
            <td><small class="text-muted font-monospace">{{#if serialNumber}}{{serialNumber}}{{else}}—{{/if}}</small></td>
            <td>
              <span class="badge bg-{{statusBadge status}}">{{status}}</span>
            </td>
            <td>
              {{#if assignedTo}}
                <i class="fas fa-user-circle me-1 text-muted"></i>{{assignedTo.username}}
              {{else}}
                <span class="text-muted">—</span>
              {{/if}}
            </td>
            <td><small>{{formatDate dateAcquired}}</small></td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <a href="/items/{{_id}}/history" class="btn btn-outline-info" title="History">
                  <i class="fas fa-history"></i>
                </a>
                <a href="/items/{{_id}}/edit" class="btn btn-outline-secondary" title="Edit">
                  <i class="fas fa-edit"></i>
                </a>
                {{#if ../isAdmin}}
                <button type="button" class="btn btn-outline-danger"
                        title="Delete"
                        onclick="confirmDelete('{{_id}}', '{{itemId}}')">
                  <i class="fas fa-trash"></i>
                </button>
                {{/if}}
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="text-center py-5 text-muted">
      <i class="fas fa-box-open fa-3x mb-3"></i>
      <p class="mb-0">No items found. <a href="/items/new">Add the first one.</a></p>
    </div>
    {{/if}}
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title text-danger"><i class="fas fa-exclamation-triangle me-2"></i>Remove Item</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">Remove item <strong id="deleteItemId"></strong> from inventory?<br>
        <small class="text-muted">This is a soft delete — history is preserved.</small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form id="deleteForm" method="POST">
          <button type="submit" class="btn btn-sm btn-danger">Remove</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function confirmDelete(id, itemId) {
  document.getElementById('deleteItemId').textContent = itemId;
  document.getElementById('deleteForm').action = '/items/' + id + '/delete';
  new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
