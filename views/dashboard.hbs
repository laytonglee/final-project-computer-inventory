<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Dashboard</h4>
  <span class="text-muted small">Welcome back, <strong>{{currentUser.username}}</strong></span>
</div>

<!-- Stats Cards -->
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
  <div class="col">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="stat-icon bg-primary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
          <i class="fas fa-boxes text-primary"></i>
        </div>
        <h2 class="fw-bold mb-0">{{stats.total}}</h2>
        <small class="text-muted">Total Assets</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="stat-icon bg-success bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
          <i class="fas fa-check-circle text-success"></i>
        </div>
        <h2 class="fw-bold mb-0 text-success">{{stats.available}}</h2>
        <small class="text-muted">Available</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="stat-icon bg-primary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
          <i class="fas fa-user-check text-primary"></i>
        </div>
        <h2 class="fw-bold mb-0 text-primary">{{stats.inUse}}</h2>
        <small class="text-muted">In Use</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="stat-icon bg-warning bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
          <i class="fas fa-tools text-warning"></i>
        </div>
        <h2 class="fw-bold mb-0 text-warning">{{stats.maintenance}}</h2>
        <small class="text-muted">Maintenance</small>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body text-center">
        <div class="stat-icon bg-secondary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
          <i class="fas fa-archive text-secondary"></i>
        </div>
        <h2 class="fw-bold mb-0 text-secondary">{{stats.retired}}</h2>
        <small class="text-muted">Retired</small>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <a href="/items/new" class="card card-hover border-0 shadow-sm text-decoration-none h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
          <i class="fas fa-plus-circle text-primary fa-lg"></i>
        </div>
        <div>
          <div class="fw-semibold">Add New Item</div>
          <small class="text-muted">Register a new asset</small>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/transactions" class="card card-hover border-0 shadow-sm text-decoration-none h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-success bg-opacity-10 p-3">
          <i class="fas fa-exchange-alt text-success fa-lg"></i>
        </div>
        <div>
          <div class="fw-semibold">Check Out / In</div>
          <small class="text-muted">Assign or return equipment</small>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/reports" class="card card-hover border-0 shadow-sm text-decoration-none h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-info bg-opacity-10 p-3">
          <i class="fas fa-chart-bar text-info fa-lg"></i>
        </div>
        <div>
          <div class="fw-semibold">View Reports</div>
          <small class="text-muted">Inventory status &amp; aging</small>
        </div>
      </div>
    </a>
  </div>
</div>

<!-- Recent Activity -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
    <h6 class="mb-0 fw-semibold"><i class="fas fa-history me-2 text-muted"></i>Recent Activity</h6>
    <a href="/transactions" class="btn btn-sm btn-outline-secondary">View All</a>
  </div>
  <div class="card-body p-0">
    {{#if recentTx.length}}
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Item</th>
            <th>Assigned To</th>
            <th>Performed By</th>
          </tr>
        </thead>
        <tbody>
          {{#each recentTx}}
          <tr>
            <td class="text-muted small">{{formatDateTime createdAt}}</td>
            <td>
              {{#if (eq type "checkout")}}
                <span class="badge bg-primary">Check Out</span>
              {{else}}
                <span class="badge bg-success">Check In</span>
              {{/if}}
            </td>
            <td>
              <a href="/items/{{item._id}}/history" class="fw-semibold text-decoration-none">
                {{item.itemId}}
              </a>
              <small class="text-muted d-block">{{item.model}}</small>
            </td>
            <td>{{#if assignedTo}}{{assignedTo.username}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
            <td>{{performedBy.username}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="text-center py-5 text-muted">
      <i class="fas fa-inbox fa-2x mb-2"></i>
      <p class="mb-0">No transactions yet.</p>
    </div>
    {{/if}}
  </div>
</div>
